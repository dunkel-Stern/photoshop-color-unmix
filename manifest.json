{
  "manifestVersion": 5,
  "id": "com.timos.whiteunmixtransparency",
  "name": "Color Unmix",
  "version": "2.0.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "24.4.0",
    "data": {
      "apiVersion": 2
    }
  },
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/pluginIcon.png",
      "scale": [1, 2],
      "theme": ["all"],
      "species": ["generic"]
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "whiteUnmixPanel",
      "label": {
        "default": "Color Unmix"
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/panelIcon.png",
          "scale": [1, 2],
          "theme": ["all"],
          "species": ["generic"]
        }
      ],
      "minimumSize": {
        "width": 260,
        "height": 420
      },
      "maximumSize": {
        "width": 2000,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 300,
        "height": 560
      },
      "preferredFloatingSize": {
        "width": 320,
        "height": 600
      }
    }
  ]
}
